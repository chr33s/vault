{
	"name": "vault",
	"version": "0.1.0",
	"private": true,
	"description": "End-to-end encrypted, local-first credential vault (Architecture C: local-first core + Cloudflare relay). Zero runtime dependencies.",
	"bin": {
		"vault": "cli/main.ts"
	},
	"type": "module",
	"scripts": {
		"check": "oxlint --type-aware --type-check . && oxfmt --check .",
		"fix": "oxfmt --write . && oxlint --type-aware --type-check --fix",
		"cli": "node cli/main.ts",
		"relay": "node relay/main.ts",
		"dev": "node --watch cli/main.ts",
		"test": "node --test test/*.test.ts",
		"test:sea": "node --test test/sea.test.ts",
		"typecheck": "tsc --noEmit",
		"bundle": "node build/bundle.ts",
		"build:sea": "bash build/make-sea.sh",
		"check:deps": "node build/check-deps.ts"
	},
	"devDependencies": {
		"@types/node": "25.9.1",
		"esbuild": "0.28.0",
		"oxfmt": "0.52.0",
		"oxlint": "1.67.0",
		"oxlint-tsgolint": "0.23.0",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=26"
	}
}
