{
	"name": "vault",
	"version": "0.3.1",
	"private": true,
	"description": "Cloudflare relay Worker for the vault (TypeScript). The local client, CLI, macOS app and self-hosted relay are Swift (swift/).",
	"type": "module",
	"scripts": {
		"check": "oxlint --type-aware --type-check . && oxfmt --check .",
		"check:deps": "node worker/scripts/check-deps.ts",
		"fix": "oxfmt --write . && oxlint --type-aware --type-check --fix",
		"test": "node --test worker/test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "26.6.3",
		"oxfmt": "0.70.0",
		"oxlint": "1.85.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": "26.10.0"
	}
}
